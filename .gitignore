# Secrets — readable local mirror is NEVER committed (see secrets-manager)
secrets/secrets.local.env
.env
*.local.env

# Playwright auth/session state
**/.auth/
playwright/.auth/

# OS / editor
.DS_Store
*.log

# Tool wiring regenerated each session by bin/link.sh (via the SessionStart hook).
# These are absolute symlinks, not portable, so they are never committed.
# Keep .claude/settings.json tracked (it holds the hook), ignore only the symlinks.
.claude/skills
.claude/commands
.claude/agents
.cursor/
.codex/
.mcp.json
