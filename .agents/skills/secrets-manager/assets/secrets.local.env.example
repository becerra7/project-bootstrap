# Copy to secrets/secrets.local.env (which is GITIGNORED) and fill in real values.
# This is the single readable source of truth. CI-scoped vars are pushed to
# GitHub Actions by bin/secrets-sync.sh; local-MCP vars are sourced into your shell.

# Mark which vars are CI-scoped so secrets-sync.sh knows what to push to GitHub.
# (Lines starting with #ci: list CI-scoped var names.)
#ci: SUPABASE_URL SUPABASE_PUBLISHABLE_KEY CLOUDFLARE_API_TOKEN CLOUDFLARE_ACCOUNT_ID FIREBASE_APP_ID FIREBASE_SERVICE_ACCOUNT

# ── CI / runtime (pushed to GitHub Actions) ─────────────────────────────────
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT=

# ── Local MCP auth (sourced into your shell; NOT pushed to GitHub) ───────────
GITHUB_PAT=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
STITCH_API_KEY=
STRIPE_SECRET_KEY=

# ── Test (staging only) ─────────────────────────────────────────────────────
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
