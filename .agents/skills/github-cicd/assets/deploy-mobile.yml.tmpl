name: Deploy Mobile

# Manual-only: build the Android debug APK and push to Firebase App Distribution.
on:
  workflow_dispatch:
    inputs:
      release_notes:
        description: 'Release notes for Firebase testers (optional)'
        type: string
        required: false
        default: ''

env:
  GRADLE_VERSION: '8.9'

jobs:
  android:
    name: Android debug APK + Firebase
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v3
        with:
          gradle-version: ${{ env.GRADLE_VERSION }}
          cache-read-only: false

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Cache module build outputs
        uses: actions/cache@v4
        with:
          path: |
            ~/.konan
            .kotlin
            shared/build
            composeApp/build
            !composeApp/build/outputs
          key: ${{ runner.os }}-build-android-${{ hashFiles('**/*.gradle.kts', 'gradle/libs.versions.toml', 'gradle.properties') }}-${{ github.ref_name }}
          restore-keys: |
            ${{ runner.os }}-build-android-${{ hashFiles('**/*.gradle.kts', 'gradle/libs.versions.toml', 'gradle.properties') }}-
            ${{ runner.os }}-build-android-

      - name: Build debug APK
        run: gradle :composeApp:assembleDebug -Pandroid.enabled=true
        env:
          SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
          SUPABASE_PUBLISHABLE_KEY: ${{ secrets.SUPABASE_PUBLISHABLE_KEY }}

      - name: Upload APK artifact
        uses: actions/upload-artifact@v4
        with:
          name: {{PROJECT}}-debug-${{ github.run_number }}
          path: composeApp/build/outputs/apk/debug/composeApp-debug.apk
          retention-days: 30

      - name: Upload to Firebase App Distribution
        uses: wzieba/Firebase-Distribution-Github-Action@v1
        with:
          appId: ${{ secrets.FIREBASE_APP_ID }}
          serviceCredentialsFileContent: ${{ secrets.FIREBASE_SERVICE_ACCOUNT }}
          groups: testers
          file: composeApp/build/outputs/apk/debug/composeApp-debug.apk
          releaseNotes: |
            ${{ inputs.release_notes }}
            Branch: ${{ github.ref_name }}
            Commit: ${{ github.sha }}
            Run: ${{ github.run_number }}
